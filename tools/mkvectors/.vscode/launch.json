{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "(Windows) Attach",
        "type": "cppvsdbg",
        "request": "attach",
        "program": "${workspaceFolder}/build/mkvectors.exe",
    },
    {
        "name": "Debug mkvectors (VS Code)",
        "type": "cppvsdbg",
        "request": "launch",
         "program": "${workspaceFolder}/build/mkvectors.exe",
        "args": ["conformance/stream-shm/v1"],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "console": "externalTerminal"
    },
    ]
}